<#@ template language="C#" #>
<#@ output extension=".cs" encoding="utf-8" #>
<#@ parameter name="MaxArity" type="System.Int32" #>
<#@ import namespace="System.Text" #>
<#= GenerateSource(MaxArity) #>
<#+
private static string GenerateSource(int maxArity)
{
    ValidateMaxArity(maxArity);

    var builder = new StringBuilder();

    builder.AppendLine("// <auto-generated />");
    builder.AppendLine("#nullable enable");
    builder.AppendLine();
    builder.AppendLine("namespace Macaron.Union;");

    for (var arity = 2; arity <= maxArity; arity++)
    {
        builder.AppendLine();
        AppendTaggedUnion(builder, arity);
    }

    return builder.ToString();
}

private static void ValidateMaxArity(int maxArity)
{
    if (maxArity < 2)
    {
        throw new ArgumentOutOfRangeException(
            paramName: nameof(maxArity),
            actualValue: maxArity,
            message: "Maximum arity must be at least 2."
        );
    }
}

private static void AppendTaggedUnion(StringBuilder source, int arity)
{
    var typeParameters = GetTypeParameters(arity);
    var unionType = $"TaggedUnion<{typeParameters}>";

    source.AppendLine("#if NET11_0_OR_GREATER");
    source.AppendLine("[global::System.Runtime.CompilerServices.Union]");
    source.AppendLine($"public readonly struct {unionType} :");
    source.AppendLine($"    global::System.IEquatable<{unionType}>,");
    source.AppendLine($"    ITaggedUnion<{typeParameters}>,");
    source.AppendLine($"    {unionType}.IUnionMembers");
    source.AppendLine("#else");
    source.AppendLine($"public readonly struct {unionType} :");
    source.AppendLine($"    global::System.IEquatable<{unionType}>,");
    source.AppendLine($"    ITaggedUnion<{typeParameters}>");
    source.AppendLine("#endif");

    for (var i = 1; i <= arity; i++)
    {
        source.AppendLine($"    where T{i} : notnull");
    }

    source.AppendLine("{");
    source.AppendLine("#if NET11_0_OR_GREATER");
    source.AppendLine("    #region Types");
    source.AppendLine("    public interface IUnionMembers");
    source.AppendLine("    {");

    for (var i = 1; i <= arity; i++)
    {
        source.AppendLine($"        static {unionType} Create(T{i} value) => new(value);");
        source.AppendLine();
    }

    source.AppendLine("        object? Value { get; }");
    source.AppendLine("    }");
    source.AppendLine("    #endregion");
    source.AppendLine("#endif");
    source.AppendLine();
    source.AppendLine("    #region Operator Overloads");
    source.AppendLine($"    public static bool operator ==({unionType} left, {unionType} right)");
    source.AppendLine("    {");
    source.AppendLine("        return left.Equals(right);");
    source.AppendLine("    }");
    source.AppendLine();
    source.AppendLine($"    public static bool operator !=({unionType} left, {unionType} right)");
    source.AppendLine("    {");
    source.AppendLine("        return !left.Equals(right);");
    source.AppendLine("    }");
    source.AppendLine("    #endregion");
    source.AppendLine();
    source.AppendLine("    #region Conversion Operators");

    for (var i = 1; i <= arity; i++)
    {
        if (i > 1)
        {
            source.AppendLine();
        }

        source.AppendLine($"    public static implicit operator {unionType}(T{i} value)");
        source.AppendLine("    {");
        source.AppendLine($"        return new {unionType}(value);");
        source.AppendLine("    }");
        source.AppendLine();
        source.AppendLine($"    public static explicit operator T{i}({unionType} value)");
        source.AppendLine("    {");
        source.AppendLine($"        if (value.TryGetValue(out T{i}? result))");
        source.AppendLine("        {");
        source.AppendLine("            return result;");
        source.AppendLine("        }");
        source.AppendLine();
        source.AppendLine("        throw new global::System.InvalidCastException(");
        source.AppendLine($"            $\"Unable to cast object of type '{{typeof({unionType})}}' to type '{{typeof(T{i})}}'.\"");
        source.AppendLine("        );");
        source.AppendLine("    }");
    }

    source.AppendLine("    #endregion");
    source.AppendLine();
    source.AppendLine("    #region Fields");
    source.AppendLine("    private readonly byte _tag;");

    for (var i = 1; i <= arity; i++)
    {
        source.AppendLine($"    private readonly T{i}? _value{i};");
    }

    source.AppendLine("    #endregion");
    source.AppendLine();
    source.AppendLine("    #region Properties");
    source.AppendLine("    public bool HasValue => _tag != 0;");
    source.AppendLine();
    source.AppendLine("    public object? Value => _tag switch");
    source.AppendLine("    {");
    source.AppendLine("        0 => null,");

    for (var i = 1; i <= arity; i++)
    {
        source.AppendLine($"        {i} => _value{i},");
    }

    source.AppendLine("        _ => throw new global::System.InvalidOperationException($\"Invalid tag: {_tag}\"),");
    source.AppendLine("    };");
    source.AppendLine("    #endregion");
    source.AppendLine();
    source.AppendLine("    #region Constructors");

    for (var i = 1; i <= arity; i++)
    {
        if (i > 1)
        {
            source.AppendLine();
        }

        source.AppendLine($"    public TaggedUnion(T{i} value)");
        source.AppendLine("    {");
        source.AppendLine("        if (value is null)");
        source.AppendLine("        {");
        source.AppendLine("            throw new global::System.ArgumentNullException(nameof(value));");
        source.AppendLine("        }");
        source.AppendLine();
        source.AppendLine($"        _tag = {i};");
        source.AppendLine($"        _value{i} = value;");
        source.AppendLine("    }");
    }

    source.AppendLine("    #endregion");
    source.AppendLine();
    source.AppendLine("    #region Overrides");
    source.AppendLine("    public override bool Equals(object? obj)");
    source.AppendLine("    {");
    source.AppendLine($"        return obj is {unionType} other && Equals(other);");
    source.AppendLine("    }");
    source.AppendLine();
    source.AppendLine("    public override int GetHashCode()");
    source.AppendLine("    {");
    source.AppendLine("        return _tag switch");
    source.AppendLine("        {");
    source.AppendLine("            0 => 0,");

    for (var i = 1; i <= arity; i++)
    {
        source.AppendLine($"            {i} => global::System.HashCode.Combine(_tag, _value{i}),");
    }

    source.AppendLine("            _ => throw new global::System.InvalidOperationException($\"Invalid tag: {_tag}\"),");
    source.AppendLine("        };");
    source.AppendLine("    }");
    source.AppendLine();
    source.AppendLine("    public override string ToString()");
    source.AppendLine("    {");
    source.AppendLine("        return _tag switch");
    source.AppendLine("        {");
    source.AppendLine("            0 => \"<Uninitialized>\",");

    for (var i = 1; i <= arity; i++)
    {
        source.AppendLine($"            {i} => $\"{{_value{i}}}\",");
    }

    source.AppendLine("            _ => throw new global::System.InvalidOperationException($\"Invalid tag: {_tag}\"),");
    source.AppendLine("        };");
    source.AppendLine("    }");
    source.AppendLine("    #endregion");
    source.AppendLine();
    source.AppendLine($"    #region IEquatable<{unionType}> Interface");
    source.AppendLine($"    public bool Equals({unionType} other)");
    source.AppendLine("    {");
    source.AppendLine("        if (_tag != other._tag)");
    source.AppendLine("        {");
    source.AppendLine("            return false;");
    source.AppendLine("        }");
    source.AppendLine();
    source.AppendLine("        return _tag switch");
    source.AppendLine("        {");
    source.AppendLine("            0 => true,");

    for (var i = 1; i <= arity; i++)
    {
        source.AppendLine($"            {i} => global::System.Collections.Generic.EqualityComparer<T{i}>.Default.Equals(");
        source.AppendLine($"                _value{i}!,");
        source.AppendLine($"                other._value{i}!");
        source.AppendLine("            ),");
    }

    source.AppendLine("            _ => throw new global::System.InvalidOperationException($\"Invalid tag: {_tag}\"),");
    source.AppendLine("        };");
    source.AppendLine("    }");
    source.AppendLine("    #endregion");
    source.AppendLine();
    source.AppendLine("    #region Methods");
    source.AppendLine("    [global::System.ComponentModel.EditorBrowsable(global::System.ComponentModel.EditorBrowsableState.Never)]");
    source.AppendLine($"    public static byte GetTag(in {unionType} value)");
    source.AppendLine("    {");
    source.AppendLine("        return value._tag;");
    source.AppendLine("    }");

    for (var i = 1; i <= arity; i++)
    {
        source.AppendLine();
        source.AppendLine("    public bool TryGetValue(");
        source.AppendLine($"        [global::System.Diagnostics.CodeAnalysis.NotNullWhen(returnValue: true)] out T{i}? value");
        source.AppendLine("    )");
        source.AppendLine("    {");
        source.AppendLine($"        if (_tag != {i})");
        source.AppendLine("        {");
        source.AppendLine("            value = default;");
        source.AppendLine();
        source.AppendLine("            return false;");
        source.AppendLine("        }");
        source.AppendLine();
        source.AppendLine($"        value = _value{i}!;");
        source.AppendLine();
        source.AppendLine("        return true;");
        source.AppendLine("    }");
    }

    source.AppendLine();
    source.AppendLine("    public void Switch(");

    for (var i = 1; i <= arity; i++)
    {
        var separator = i < arity ? "," : "";
        source.AppendLine($"        global::System.Action<T{i}> t{i}{separator}");
    }

    source.AppendLine("    )");
    source.AppendLine("    {");
    source.AppendLine("        switch (this._tag)");
    source.AppendLine("        {");
    source.AppendLine("            case 0:");
    source.AppendLine("                throw new global::System.InvalidOperationException(\"Value not initialized.\");");

    for (var i = 1; i <= arity; i++)
    {
        source.AppendLine($"            case {i}:");
        source.AppendLine($"                t{i}(this._value{i}!);");
        source.AppendLine("                return;");
    }

    source.AppendLine("            default:");
    source.AppendLine("                throw new global::System.InvalidOperationException($\"Invalid tag: {this._tag}\");");
    source.AppendLine("        }");
    source.AppendLine("    }");
    source.AppendLine();
    source.AppendLine("    public void Switch<TState>(");
    source.AppendLine("        TState state,");

    for (var i = 1; i <= arity; i++)
    {
        var separator = i < arity ? "," : "";
        source.AppendLine($"        global::System.Action<T{i}, TState> t{i}{separator}");
    }

    source.AppendLine("    )");
    source.AppendLine("    {");
    source.AppendLine("        switch (this._tag)");
    source.AppendLine("        {");
    source.AppendLine("            case 0:");
    source.AppendLine("                throw new global::System.InvalidOperationException(\"Value not initialized.\");");

    for (var i = 1; i <= arity; i++)
    {
        source.AppendLine($"            case {i}:");
        source.AppendLine($"                t{i}(this._value{i}!, state);");
        source.AppendLine("                return;");
    }

    source.AppendLine("            default:");
    source.AppendLine("                throw new global::System.InvalidOperationException($\"Invalid tag: {this._tag}\");");
    source.AppendLine("        }");
    source.AppendLine("    }");
    source.AppendLine();
    source.AppendLine("    public TResult Match<TResult>(");

    for (var i = 1; i <= arity; i++)
    {
        var separator = i < arity ? "," : "";
        source.AppendLine($"        global::System.Func<T{i}, TResult> t{i}{separator}");
    }

    source.AppendLine("    )");
    source.AppendLine("    {");
    source.AppendLine("        return this._tag switch");
    source.AppendLine("        {");
    source.AppendLine("            0 => throw new global::System.InvalidOperationException(\"Value not initialized.\"),");

    for (var i = 1; i <= arity; i++)
    {
        source.AppendLine($"            {i} => t{i}(this._value{i}!),");
    }

    source.AppendLine("            _ => throw new global::System.InvalidOperationException($\"Invalid tag: {this._tag}\"),");
    source.AppendLine("        };");
    source.AppendLine("    }");
    source.AppendLine();
    source.AppendLine("    public TResult Match<TState, TResult>(");
    source.AppendLine("        TState state,");

    for (var i = 1; i <= arity; i++)
    {
        var separator = i < arity ? "," : "";
        source.AppendLine($"        global::System.Func<T{i}, TState, TResult> t{i}{separator}");
    }

    source.AppendLine("    )");
    source.AppendLine("    {");
    source.AppendLine("        return this._tag switch");
    source.AppendLine("        {");
    source.AppendLine("            0 => throw new global::System.InvalidOperationException(\"Value not initialized.\"),");

    for (var i = 1; i <= arity; i++)
    {
        source.AppendLine($"            {i} => t{i}(this._value{i}!, state),");
    }

    source.AppendLine("            _ => throw new global::System.InvalidOperationException($\"Invalid tag: {this._tag}\"),");
    source.AppendLine("        };");
    source.AppendLine("    }");
    source.AppendLine("    #endregion");
    source.AppendLine("}");
}

private static string GetTypeParameters(int arity)
{
    var typeParameters = new StringBuilder();

    for (var i = 1; i <= arity; i++)
    {
        if (i > 1)
        {
            typeParameters.Append(", ");
        }

        typeParameters.Append($"T{i}");
    }

    return typeParameters.ToString();
}
#>
