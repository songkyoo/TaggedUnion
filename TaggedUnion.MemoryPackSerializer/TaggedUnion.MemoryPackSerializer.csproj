<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Macaron.TaggedUnion.MemoryPackSerializer</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Macaron.Union</RootNamespace>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Version>$(TaggedUnionMemoryPackSerializerVersion)</Version>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Gyu Song</Authors>
    <PackageId>Macaron.TaggedUnion.MemoryPackSerializer</PackageId>
    <PackageLicenseExpression>Unlicense</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/songkyoo/TaggedUnion</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MemoryPack" Version="1.21.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaggedUnion\TaggedUnion.csproj" BuildReference="false" PrivateAssets="none" />
    <ProjectReference Include="..\TaggedUnion.MemoryPackSerializer.Generator\TaggedUnion.MemoryPackSerializer.Generator.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\TaggedUnion.MemoryPackSerializer.Generator\bin\$(Configuration)\netstandard2.0\Macaron.TaggedUnion.MemoryPackSerializer.Generator.dll" Pack="true" PackagePath="analyzers/dotnet/cs" />
  </ItemGroup>

</Project>
